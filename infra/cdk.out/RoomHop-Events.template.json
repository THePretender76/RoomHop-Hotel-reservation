  "NotificationHandler5A872A20": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nconst { SESv2Client, SendEmailCommand } = require('@aws-sdk/client-sesv2');\n\nconst sesClient = new SESv2Client({});\n\nexports.handler = async (event) => {\n  for (const record of event.Records) {\n    const body = JSON.parse(record.body);\n    const detail = body.detail || body;\n    const detailType = body['detail-type'] || 'BookingConfirmed';\n    \n    const subject = detailType === 'BookingConfirmed'\n      ? 'Booking Confirmation - RoomHop'\n      : 'Booking Cancellation - RoomHop';\n    \n    const emailBody = detailType === 'BookingConfirmed'\n      ? `Dear ${detail.guestName},\\n\\nYour booking (ID: ${detail.reservationId}) has been confirmed.\\nCheck-in: ${detail.checkIn}\\nCheck-out: ${detail.checkOut}\\n\\nThank you for choosing RoomHop!`\n      : `Dear ${detail.guestName},\\n\\nYour booking (ID: ${detail.reservationId}) has been cancelled.\\n\\nWe hope to see you again soon.`;\n\n    try {\n      await sesClient.send(new SendEmailCommand({\n        FromEmailAddress: 'noreply@roomhop.com',\n        Destination: { ToAddresses: [detail.guestEmail] },\n        Content: {\n          Simple: {\n            Subject: { Data: subject },\n            Body: { Text: { Data: emailBody } },\n          },\n        },\n      }));\n      console.log(`Email sent to ${detail.guestEmail} for ${detailType}`);\n    } catch (error) {\n      console.error('Failed to send email:', error);\n      throw error;\n    }\n  }\n};\n"
    },
    "Environment": {
     "Variables": {
      "REGION": "eu-west-1"
     }
    },
    "FunctionName": "roomhop-notification-handler",
    "Handler": "index.handler",
    "MemorySize": 256,
    "Role": {
     "Fn::GetAtt": [
      "NotificationHandlerServiceRole75069BD7",
      "Arn"
     ]
    },
    "Runtime": "nodejs20.x",
    "Timeout": 30,
    "VpcConfig": {
     "SecurityGroupIds": [
      {
       "Fn::ImportValue": "RoomHop-Network:ExportsOutputFnGetAttLambdaSg30A6108CGroupId30BB2F0D"
      }
     ],
     "SubnetIds": [
      {
       "Fn::ImportValue": "RoomHop-Network:ExportsOutputRefRoomHopVpcPrivateSubnet1SubnetF4CFC437D54E75B2"
      },
      {
       "Fn::ImportValue": "RoomHop-Network:ExportsOutputRefRoomHopVpcPrivateSubnet2Subnet2E0B0C6F2C8C1A50"
      }
     ]
    }
   },
   "DependsOn": [
    "NotificationHandlerServiceRoleDefaultPolicy02DD28C2",
    "NotificationHandlerServiceRole75069BD7"
   ],
   "Metadata": {
    "aws:cdk:path": "RoomHop-Events/NotificationHandler/Resource"
   }
  },
