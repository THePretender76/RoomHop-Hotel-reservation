  "AnalyticsHandlerF43C4325": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nconst { S3Client, PutObjectCommand } = require('@aws-sdk/client-s3');\n\nconst s3Client = new S3Client({});\nconst BUCKET = process.env.ANALYTICS_BUCKET;\n\nexports.handler = async (event) => {\n  for (const record of event.Records) {\n    const body = JSON.parse(record.body);\n    const detail = body.detail || body;\n    const detailType = body['detail-type'] || 'Unknown';\n    const timestamp = new Date().toISOString();\n    const date = timestamp.split('T')[0];\n    \n    // Partition by date and event type for efficient Athena queries\n    const key = `reservations/year=${date.split('-')[0]}/month=${date.split('-')[1]}/day=${date.split('-')[2]}/${detailType}_${detail.reservationId || Date.now()}.json`;\n    \n    const record_data = {\n      eventType: detailType,\n      reservationId: detail.reservationId,\n      guestEmail: detail.guestEmail,\n      guestName: detail.guestName,\n      hotelId: detail.hotelId,\n      roomType: detail.roomType,\n      checkIn: detail.checkIn,\n      checkOut: detail.checkOut,\n      totalAmount: detail.totalAmount,\n      currency: detail.currency || 'EUR',\n      timestamp,\n    };\n\n    try {\n      await s3Client.send(new PutObjectCommand({\n        Bucket: BUCKET,\n        Key: key,\n        Body: JSON.stringify(record_data),\n        ContentType: 'application/json',\n      }));\n      console.log(`Analytics record written: ${key}`);\n    } catch (error) {\n      console.error('Failed to write analytics record:', error);\n      throw error;\n    }\n  }\n};\n"
    },
    "Environment": {
     "Variables": {
      "ANALYTICS_BUCKET": {
       "Ref": "AnalyticsBucket39EAAEEA"
      },
      "REGION": "eu-west-1"
     }
    },
    "FunctionName": "roomhop-analytics-handler",
    "Handler": "index.handler",
    "MemorySize": 256,
    "Role": {
     "Fn::GetAtt": [
      "AnalyticsHandlerServiceRole3658EDAF",
      "Arn"
     ]
    },
    "Runtime": "nodejs20.x",
    "Timeout": 60,
    "VpcConfig": {
     "SecurityGroupIds": [
      {
       "Fn::ImportValue": "RoomHop-Network:ExportsOutputFnGetAttLambdaSg30A6108CGroupId30BB2F0D"
      }
     ],
     "SubnetIds": [
      {
       "Fn::ImportValue": "RoomHop-Network:ExportsOutputRefRoomHopVpcPrivateSubnet1SubnetF4CFC437D54E75B2"
      },
      {
       "Fn::ImportValue": "RoomHop-Network:ExportsOutputRefRoomHopVpcPrivateSubnet2Subnet2E0B0C6F2C8C1A50"
      }
     ]
    }
