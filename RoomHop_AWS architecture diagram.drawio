        <mxCell id="SCchAOsyZcud_EP7V0Vg-104" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="The user opens the application in the browser and authenticates with Amazon Cognito. Cognito authenticates the user and returns a secure JSON Web Token (JWT) to the browser." vertex="1">
          <mxGeometry height="30" width="1071.9" x="429.5" y="1330" as="geometry" />
        </mxCell>
