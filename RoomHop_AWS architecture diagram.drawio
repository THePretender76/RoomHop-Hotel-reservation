        </mxCell>
        <mxCell id="rWEoU4T3lSHwKHvLbqA2-20" edge="1" parent="1" source="ngVDmUoELbAkNXuveCA4-1" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" target="SCchAOsyZcud_EP7V0Vg-12" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="2180" y="835" as="sourcePoint" />
            <mxPoint x="2230" y="785" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rWEoU4T3lSHwKHvLbqA2-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=8;container=0;" value="Use metadata to understand schema" vertex="1">
          <mxGeometry height="30" width="79" x="2236.5" y="814.75" as="geometry" />
        </mxCell>
        <mxCell id="rWEoU4T3lSHwKHvLbqA2-23" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;After a reservation is successfully created, the Reservation Service publishes a &lt;code&gt;ReservationCreated&lt;/code&gt; event to Amazon EventBridge through a VPC Interface Endpoint. EventBridge routes the event to dedicated SQS queues, decoupling downstream processing from the synchronous reservation transaction.&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="1060" x="480" y="1650" as="geometry" />
        </mxCell>
        <mxCell id="rWEoU4T3lSHwKHvLbqA2-24" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;The notification SQS queue triggers a Lambda function that processes the reservation event and sends a confirmation email through Amazon SES. If message processing repeatedly fails, SQS moves the message to the configured Dead-Letter Queue (DLQ), where a CloudWatch alarm can trigger an SNS notification for operational investigation.&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="1060" x="480" y="1710" as="geometry" />
        </mxCell>
        <mxCell id="rWEoU4T3lSHwKHvLbqA2-25" parent="1" style="text;whiteSpace=wrap;html=1;" value="The analytics SQS queue triggers a Lambda function that stores reservation events in Amazon S3. An AWS Glue Crawler periodically scans the reservation data and updates the AWS Glue Data Catalog with table and schema metadata. Amazon Athena queries the actual data directly from S3 using this metadata, making the reservation dataset available to Metabase for analytics and reporting." vertex="1">
          <mxGeometry height="70" width="1040" x="482" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="xnJLXE7O6beuAYsWoXHs-15" edge="1" parent="1" source="rWEoU4T3lSHwKHvLbqA2-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="xnJLXE7O6beuAYsWoXHs-2" value="">
