        <mxCell id="rWEoU4T3lSHwKHvLbqA2-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=8;container=0;" value="Scan new data" vertex="1">
