        <mxCell id="rWEoU4T3lSHwKHvLbqA2-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=10;container=0;" value="Read data from S3" vertex="1">
          <mxGeometry height="30" width="108.5" x="2160" y="709" as="geometry" />
